{
  "name": "wakusei",
  "version": "0.0.4",
  "description": "OpenAPI/TypeSpec to oRPC code generator",
  "keywords": [
    "codegen",
    "openapi",
    "orpc",
    "typespec"
  ],
  "homepage": "https://github.com/nakita628/wakusei",
  "bugs": {
    "url": "https://github.com/nakita628/wakusei/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/wakusei.git"
  },
  "bin": {
    "wakusei": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "coverage": "vp test --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5",
    "oas-truth": "^0.5.1",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
